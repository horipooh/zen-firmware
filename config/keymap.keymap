#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        lang1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <15 16>;
        };

        lang2 {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <19 20>;
        };
    };

    macros {
        horipu: horipu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp H &kp O &kp R &kp I &kp P &kp U &kp RET>;
            label = "HORIPU";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q             &kp W      &kp E         &kp R                    &kp T        &horipu           &kp Y          &kp U          &kp I          &kp O           &kp P           &kp RS(RA(RC(RG(F))))
&kp A             &kp S      &kp D         &kp F                    &kp G        &kp EXCLAMATION   &kp H          &kp J          &kp K          &kp L           &kp ENTER       &kp ENTER
&mt LEFT_SHIFT Z  &kp X      &kp C         &kp V                    &kp B        &kp QUESTION      &kp PAGE_UP    &kp MINUS      &kp N          &kp M           &kp COMMA       &kp PERIOD             &kp UP_ARROW  &mt RSHFT QUESTION
&kp LEFT_SHIFT    &kp LCTRL  &kp LEFT_ALT  &mt LEFT_WIN LANGUAGE_1  &lt 2 SPACE  &lt 3 LANGUAGE_2  &kp PAGE_DOWN  &kp BACKSPACE  &kp BACKSPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp EXCLAMATION  &kp N7        &kp N8        &kp N9        &kp MINUS  &trans    &kp RC(RA(LEFT_ARROW))  &kp RA(RC(D))  &kp RA(RC(ENTER))      &kp RA(RC(T))  &kp RA(RC(RIGHT_ARROW))  &trans
&kp PERCENT      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS   &kp HASH  &kp LEFT_PARENTHESIS    &mkp MB1       &trans                 &mkp MB2       &trans                   &trans
&kp PIPE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &kp AT    &trans                  &trans         &kp RIGHT_PARENTHESIS  &kp UNDER      &trans                   &trans  &trans  &kp QUESTION
&trans           &kp N0        &kp PERIOD    &kp COMMA     &trans     &trans    &trans                  &trans         &trans                 &trans         &trans                   &trans
            >;
        };

        Macro,bt {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans  &trans  &trans  &trans  &trans  &kp LG(F10)  &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
